rules_version = '2';

// ===============================================================
// Предполагаемая модель данных (источник правды — js/auth.js, ADMIN_RECORDS и dispatch)
// ===============================================================
//
// Вход: Firebase Auth по служебному адресу <логин>@<USERNAME_DOMAIN> (js/firebase-config.js).
// Логин пользователя = часть адреса до «@». Профиль лежит в users/{логин} и действителен,
// только если его поле uid совпадает с request.auth.uid — поэтому чужой аккаунт с тем же
// логином на другом домене ничего не получит.
//
// users/{username}          username: string ^[a-z0-9._-]{3,40}$ (= id документа, неизменяем)
//                           uid: string (неизменяем), name: string 1..100,
//                           role: 'admin' | 'student' | 'parent' (через приложение — только student/parent),
//                           grade: int 1..11 | null, child: string (логин ученика у родителя, иначе '')
// materials/{id}            title 1..200, grade int 1..11 | null, url ''|http(s) ≤1000,
//                           description ≤2000, topic ≤200, type: material|video|test|worksheet
// homework/{id}             student, title 1..300, assigned, due (ГГГГ-ММ-ДД), status: pending|done,
//                           link ''|http(s) ≤1000, comment ≤2000
// schedule/{id}             date, time ''|ЧЧ:ММ, type: lesson|deadline|test|olympiad, title 1..200,
//                           description ≤2000, student ('' — событие для всех), status: planned|done|cancelled
// grades/{id}               student, subject: Математика|Алгебра|Геометрия, grade int 1..5, date, comment ≤500
// lessonNotes/{id}          date, student, topic 1..200, note ≤5000, rating int 0..5, duration int 1..600
// payments/{id}             date, student, amount number |x| ≤ 1e7, type: paid|lesson|refund, description ≤500
// achievements/{id}         student, title 1..120, description ≤500, date, icon ≤16
// messages/{id}             from, to (логины), text 1..2000, date, isRead: bool
// topics/{id}               subject, title 1..200, description ≤2000
// files/{id}                прикреплённый файл (метаданные): name 1..200, type ≤100, size int 1..5 МБ,
//                           chunks int 1..6, thumb ≤40000 (миниатюра data:image… или ''), kind: material|homework|message,
//                           parentId (id записи), owner (кто загрузил = свой логин), student, from, to, date.
//                           Для material student/from/to пустые; для homework student = ученик задания;
//                           для message from/to = отправитель/получатель сообщения. Неизменяем после создания.
// files/{id}/chunks/{n}     кусок содержимого файла: data — bytes ≤ 950000; n = 0..chunks-1
// tests/{id}                тест: title 1..200, topic ≤200, grade int 1..11 | null, student ('' — для всех),
//                           description ≤2000, date, questions — список 1..30 вопросов {text, type, options}
// testKeys/{testId}         правильные ответы теста: answers — список строк; ученик видит ключ только ПОСЛЕ сдачи
// testResults/{testId}_{student}  ответы ученика: testId, student, answers (список), date; неизменяемы.
//                           Балл не хранится — считается из ответов и ключа, поэтому подделать его нельзя.
// practiceResults/{id}      тренировка на оценку: student, topic ≤200, correct int, total int 1..20,
//                           grade int 2..5 строго по шкале (90% → 5, 75% → 4, 50% → 3, иначе 2), date.
//                           Пишет сам ученик — это самопроверка, ответы в банке открыты.
// homework.testId           необязательный тест к домашнему заданию ('' или id теста)
// problems/{id}             банк задач: topic 1..200, grade int 1..11 | null, difficulty int 1..3,
//                           text 1..4000, answer 1..300, solution ≤4000 (ответы открыты — это тренировка)
//
// Доступ:
//   admin   — читает и пишет всё (кроме создания других админов).
//   student — читает свои записи (поле student == свой логин), общие материалы/темы/события,
//             меняет только status своих домашних заданий.
//   parent  — то же, что его ученик (users.child), плюс свои сообщения.
//   Сообщения: писать можно любому участнику сайта; читают отправитель, получатель и родитель ученика
//             из переписки; удаляют репетитор (любые) и отправитель (свои).
// directory/{username}      справочник для выбора адресата: name 1..100, role; читают все участники, пишет репетитор.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Кто спрашивает ----------
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }
    function myUsername() {
      return request.auth.token.email.lower().split('@')[0];
    }
    function userPath(name) {
      return /databases/$(database)/documents/users/$(name);
    }
    function me() {
      return get(userPath(myUsername())).data;
    }
    function isMember() {
      return signedIn() && exists(userPath(myUsername())) && me().uid == request.auth.uid;
    }
    function isAdmin() {
      return isMember() && me().role == 'admin';
    }
    // s — логин ученика, чьи записи запрашиваются: свой для ученика, ребёнка для родителя.
    function isMyStudent(s) {
      return isMember() && s is string && s != '' &&
        ((me().role == 'student' && s == myUsername()) ||
         (me().role == 'parent' && s == me().child));
    }
    // Участник переписки: я сам или мой ученик.
    function isMyParty(u) {
      return isMember() && (u == myUsername() || isMyStudent(u));
    }

    // ---------- Проверки полей ----------
    function hasExactly(d, fields) {
      return d.keys().hasAll(fields) && d.keys().hasOnly(fields);
    }
    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function login(v) {
      return v is string && v.matches('^[a-z0-9._-]{3,40}$');
    }
    function day(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function url(v) {
      return str(v, 0, 1000) && (v == '' || v.matches('^https?://.+'));
    }
    function intIn(v, min, max) {
      return v is int && v >= min && v <= max;
    }
    function optGrade(v) {
      return v == null || intIn(v, 1, 11);
    }
    function subject(v) {
      return v in ['Математика', 'Алгебра', 'Геометрия'];
    }

    // ---------- Валидаторы документов (вызываются и в create, и в update) ----------
    function isValidUser(d, username) {
      // nameGen — необязательное имя ученика в родительном падеже («успеваемость Захара»)
      return d.keys().hasAll(['username', 'uid', 'name', 'role', 'grade', 'child']) &&
        d.keys().hasOnly(['username', 'uid', 'name', 'role', 'grade', 'child', 'nameGen']) &&
        (!('nameGen' in d) || (str(d.nameGen, 0, 100) && d.role == 'student')) &&
        login(d.username) && d.username == username &&
        str(d.uid, 1, 128) && str(d.name, 1, 100) &&
        d.role in ['admin', 'student', 'parent'] &&
        optGrade(d.grade) &&
        ((d.role == 'parent' && login(d.child) &&
          exists(userPath(d.child)) && get(userPath(d.child)).data.role == 'student') ||
         (d.role != 'parent' && d.child == ''));
    }
    function isValidMaterial(d) {
      return hasExactly(d, ['title', 'grade', 'url', 'description', 'topic', 'type']) &&
        str(d.title, 1, 200) && optGrade(d.grade) && url(d.url) &&
        str(d.description, 0, 2000) && str(d.topic, 0, 200) &&
        d.type in ['material', 'video', 'test', 'worksheet'];
    }
    // testId — необязательный тест к заданию (у старых заданий поля нет).
    function isValidHomework(d) {
      return d.keys().hasAll(['student', 'title', 'assigned', 'due', 'status', 'link', 'comment']) &&
        d.keys().hasOnly(['student', 'title', 'assigned', 'due', 'status', 'link', 'comment', 'testId']) &&
        login(d.student) && str(d.title, 1, 300) && day(d.assigned) && day(d.due) &&
        d.status in ['pending', 'done'] && url(d.link) && str(d.comment, 0, 2000) &&
        (!('testId' in d) || str(d.testId, 0, 64));
    }
    function isValidEvent(d) {
      return hasExactly(d, ['date', 'time', 'type', 'title', 'description', 'student', 'status']) &&
        day(d.date) && d.time is string && (d.time == '' || d.time.matches('^[0-9]{2}:[0-9]{2}$')) &&
        d.type in ['lesson', 'deadline', 'test', 'olympiad'] &&
        str(d.title, 1, 200) && str(d.description, 0, 2000) &&
        (d.student == '' || login(d.student)) &&
        d.status in ['planned', 'done', 'cancelled'];
    }
    function isValidGrade(d) {
      return hasExactly(d, ['student', 'subject', 'grade', 'date', 'comment']) &&
        login(d.student) && subject(d.subject) && intIn(d.grade, 1, 5) && day(d.date) && str(d.comment, 0, 500);
    }
    function isValidNote(d) {
      return hasExactly(d, ['date', 'student', 'topic', 'note', 'rating', 'duration']) &&
        day(d.date) && login(d.student) && str(d.topic, 1, 200) && str(d.note, 0, 5000) &&
        intIn(d.rating, 0, 5) && intIn(d.duration, 1, 600);
    }
    function isValidPayment(d) {
      return hasExactly(d, ['date', 'student', 'amount', 'type', 'description']) &&
        day(d.date) && login(d.student) && d.amount is number &&
        d.amount >= -10000000 && d.amount <= 10000000 &&
        d.type in ['paid', 'lesson', 'refund'] && str(d.description, 0, 500);
    }
    function isValidAchievement(d) {
      return hasExactly(d, ['student', 'title', 'description', 'date', 'icon']) &&
        login(d.student) && str(d.title, 1, 120) && str(d.description, 0, 500) && day(d.date) && str(d.icon, 0, 16);
    }
    function isValidMessage(d) {
      return hasExactly(d, ['from', 'to', 'text', 'date', 'isRead']) &&
        login(d.from) && login(d.to) && str(d.text, 1, 2000) && day(d.date) && d.isRead is bool;
    }
    function isValidTopic(d) {
      return hasExactly(d, ['subject', 'title', 'description']) &&
        subject(d.subject) && str(d.title, 1, 200) && str(d.description, 0, 2000);
    }

    // Кому можно писать: админ — всем; остальные — репетитору, своему ребёнку или родителю.
    // Писать можно любому участнику сайта (ученикам, родителям, репетитору), но не самому себе.
    function canMessage(to) {
      return exists(userPath(to)) && to != myUsername();
    }

    // ---------- Коллекции ----------
    match /users/{username} {
      allow read: if isAdmin() || (isMember() && username == myUsername()) ||
        (isMember() && me().role == 'parent' && username == me().child);
      // Админов создают только из консоли или скриптом миграции (Admin SDK обходит правила).
      allow create: if isAdmin() && isValidUser(request.resource.data, username) &&
        request.resource.data.role in ['student', 'parent'];
      allow update: if isAdmin() && isValidUser(request.resource.data, username) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role;
      allow delete: if isAdmin() && username != myUsername();
    }

    // Справочник имён для выбора адресата: логин → имя и роль. Пишет репетитор (сайт сам сверяет его с users).
    match /directory/{username} {
      allow read: if isMember();
      allow create, update: if isAdmin() && login(username) &&
        hasExactly(request.resource.data, ['name', 'role']) && str(request.resource.data.name, 1, 100) &&
        request.resource.data.role in ['admin', 'student', 'parent'];
      allow delete: if isAdmin();
    }

    match /materials/{id} {
      allow read: if isMember();
      allow create, update: if isAdmin() && isValidMaterial(request.resource.data);
      allow delete: if isAdmin();
    }

    match /topics/{id} {
      allow read: if isMember();
      allow create, update: if isAdmin() && isValidTopic(request.resource.data);
      allow delete: if isAdmin();
    }

    match /homework/{id} {
      allow read: if isAdmin() || isMyStudent(resource.data.student);
      allow create: if isAdmin() && isValidHomework(request.resource.data);
      // Ученик и родитель могут менять только статус своего задания.
      allow update: if isValidHomework(request.resource.data) &&
        (isAdmin() ||
         (isMyStudent(resource.data.student) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));
      allow delete: if isAdmin();
    }

    match /schedule/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.student == '') || isMyStudent(resource.data.student);
      allow create, update: if isAdmin() && isValidEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    match /grades/{id} {
      allow read: if isAdmin() || isMyStudent(resource.data.student);
      allow create, update: if isAdmin() && isValidGrade(request.resource.data);
      allow delete: if isAdmin();
    }

    match /lessonNotes/{id} {
      allow read: if isAdmin() || isMyStudent(resource.data.student);
      allow create, update: if isAdmin() && isValidNote(request.resource.data);
      allow delete: if isAdmin();
    }

    match /payments/{id} {
      allow read: if isAdmin() || isMyStudent(resource.data.student);
      allow create, update: if isAdmin() && isValidPayment(request.resource.data);
      allow delete: if isAdmin();
    }

    match /achievements/{id} {
      allow read: if isAdmin() || isMyStudent(resource.data.student);
      allow create, update: if isAdmin() && isValidAchievement(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------- Прикреплённые файлы ----------
    function filePath(id) {
      return /databases/$(database)/documents/files/$(id);
    }
    function isValidFileMeta(d) {
      return hasExactly(d, ['name', 'type', 'size', 'chunks', 'thumb', 'kind', 'parentId', 'owner', 'student', 'from', 'to', 'date']) &&
        str(d.name, 1, 200) && str(d.type, 0, 100) &&
        d.size is int && d.size >= 1 && d.size <= 5242880 &&
        d.chunks is int && d.chunks >= 1 && d.chunks <= 6 &&
        str(d.thumb, 0, 40000) && (d.thumb == '' || d.thumb.matches('^data:image/[a-z]+;base64,.*')) &&
        d.kind in ['material', 'homework', 'message'] && str(d.parentId, 1, 64) &&
        day(d.date) && d.student is string && d.from is string && d.to is string;
    }
    // Прикрепить можно только к существующей записи, на которую у автора есть права.
    function canAttach(d) {
      return d.owner == myUsername() && (
        (d.kind == 'material' && isAdmin() && d.student == '' && d.from == '' && d.to == '' &&
          exists(/databases/$(database)/documents/materials/$(d.parentId))) ||
        (d.kind == 'homework' && d.from == '' && d.to == '' &&
          exists(/databases/$(database)/documents/homework/$(d.parentId)) &&
          get(/databases/$(database)/documents/homework/$(d.parentId)).data.student == d.student &&
          (isAdmin() || isMyStudent(d.student))) ||
        (d.kind == 'message' && d.student == '' &&
          exists(/databases/$(database)/documents/messages/$(d.parentId)) &&
          get(/databases/$(database)/documents/messages/$(d.parentId)).data.from == myUsername() &&
          get(/databases/$(database)/documents/messages/$(d.parentId)).data.from == d.from &&
          get(/databases/$(database)/documents/messages/$(d.parentId)).data.to == d.to));
    }
    // Видит файл тот, кто видит запись: материалы — все, ДЗ — ученик и его родитель, сообщения — участники.
    function canReadFile(d) {
      return isAdmin() ||
        (d.kind == 'material' && isMember()) ||
        (d.kind == 'homework' && isMyStudent(d.student)) ||
        (d.kind == 'message' && (isMyParty(d.from) || isMyParty(d.to)));
    }
    function isValidChunk(fileId, n) {
      return isMember() && n.matches('^[0-5]$') &&
        getAfter(filePath(fileId)).data.owner == myUsername() &&
        int(n) < getAfter(filePath(fileId)).data.chunks &&
        request.resource.data.keys().hasOnly(['data']) &&
        request.resource.data.data is bytes && request.resource.data.data.size() <= 950000;
    }

    match /files/{fileId} {
      allow read: if canReadFile(resource.data);
      allow create: if isMember() && isValidFileMeta(request.resource.data) && canAttach(request.resource.data);
      allow delete: if isAdmin() || (isMember() && resource.data.owner == myUsername());

      match /chunks/{n} {
        allow read: if canReadFile(get(filePath(fileId)).data);
        allow create: if isValidChunk(fileId, n);
        allow delete: if isAdmin() || (isMember() && get(filePath(fileId)).data.owner == myUsername());
      }
    }

    // ---------- Тесты и банк задач ----------
    function testPath(id) {
      return /databases/$(database)/documents/tests/$(id);
    }
    function resultPath(id) {
      return /databases/$(database)/documents/testResults/$(id);
    }
    function isValidTest(d) {
      return hasExactly(d, ['title', 'topic', 'grade', 'student', 'description', 'date', 'questions']) &&
        str(d.title, 1, 200) && str(d.topic, 0, 200) && optGrade(d.grade) &&
        (d.student == '' || login(d.student)) && str(d.description, 0, 2000) && day(d.date) &&
        d.questions is list && d.questions.size() >= 1 && d.questions.size() <= 30;
    }
    function isValidResult(d) {
      return hasExactly(d, ['testId', 'student', 'answers', 'date']) &&
        str(d.testId, 1, 64) && login(d.student) && day(d.date) &&
        d.answers is list && d.answers.size() <= 30;
    }
    function isValidProblem(d) {
      return hasExactly(d, ['topic', 'grade', 'difficulty', 'text', 'answer', 'solution']) &&
        str(d.topic, 1, 200) && optGrade(d.grade) && intIn(d.difficulty, 1, 3) &&
        str(d.text, 1, 4000) && str(d.answer, 1, 300) && str(d.solution, 0, 4000);
    }
    // Ключ открывается ученику после сдачи; родителю — после того, как сдал его ребёнок.
    function hasSubmitted(testId) {
      return isMember() && (exists(resultPath(testId + '_' + myUsername())) ||
        (me().role == 'parent' && me().child != '' && exists(resultPath(testId + '_' + me().child))));
    }

    match /tests/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.student == '') || isMyStudent(resource.data.student);
      allow create, update: if isAdmin() && isValidTest(request.resource.data);
      allow delete: if isAdmin();
    }

    match /testKeys/{testId} {
      allow read: if isAdmin() || hasSubmitted(testId);
      allow create, update: if isAdmin() && hasExactly(request.resource.data, ['answers']) &&
        request.resource.data.answers is list &&
        request.resource.data.answers.size() >= 1 && request.resource.data.answers.size() <= 30;
      allow delete: if isAdmin();
    }

    match /testResults/{resultId} {
      allow read: if isAdmin() || isMyStudent(resource.data.student);
      // Сдаёт только сам ученик, один раз, тест должен быть ему доступен, ответов — ровно по числу вопросов.
      allow create: if isMember() && me().role == 'student' &&
        isValidResult(request.resource.data) &&
        request.resource.data.student == myUsername() &&
        resultId == request.resource.data.testId + '_' + myUsername() &&
        exists(testPath(request.resource.data.testId)) &&
        get(testPath(request.resource.data.testId)).data.student in ['', myUsername()] &&
        request.resource.data.answers.size() == get(testPath(request.resource.data.testId)).data.questions.size();
      allow delete: if isAdmin();
    }

    // Оценка тренировки должна соответствовать шкале.
    function gradeMatches(g, c, t) {
      return (g == 5 && c * 100 >= t * 90) ||
        (g == 4 && c * 100 >= t * 75 && c * 100 < t * 90) ||
        (g == 3 && c * 100 >= t * 50 && c * 100 < t * 75) ||
        (g == 2 && c * 100 < t * 50);
    }
    function isValidPractice(d) {
      return hasExactly(d, ['student', 'topic', 'correct', 'total', 'grade', 'date']) &&
        login(d.student) && str(d.topic, 1, 200) && day(d.date) &&
        intIn(d.total, 1, 20) && intIn(d.correct, 0, d.total) && intIn(d.grade, 2, 5) &&
        gradeMatches(d.grade, d.correct, d.total);
    }

    match /practiceResults/{id} {
      allow read: if isAdmin() || isMyStudent(resource.data.student);
      allow create: if isMember() && me().role == 'student' &&
        isValidPractice(request.resource.data) && request.resource.data.student == myUsername();
      allow delete: if isAdmin();
    }

    match /problems/{id} {
      allow read: if isMember();
      allow create, update: if isAdmin() && isValidProblem(request.resource.data);
      allow delete: if isAdmin();
    }

    match /messages/{id} {
      allow read: if isAdmin() || isMyParty(resource.data.from) || isMyParty(resource.data.to);
      allow create: if isMember() && isValidMessage(request.resource.data) &&
        request.resource.data.from == myUsername() &&
        request.resource.data.isRead == false &&
        canMessage(request.resource.data.to);
      // Отметить прочитанным может только получатель (или родитель получателя), и только поле isRead.
      allow update: if isValidMessage(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
        request.resource.data.isRead == true &&
        (isAdmin() || (isMyParty(resource.data.to) && resource.data.from != myUsername()));
      // Удаляет репетитор любое сообщение, остальные — только свои отправленные.
      allow delete: if isAdmin() || (isMember() && resource.data.from == myUsername());
    }
  }
}
